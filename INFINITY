//@version=5
indicator("Infinity trade", overlay=true)
Periods = input(title="ATR Period", defval=10)
src = input(hl2, title="Source")
Multiplier = input(title="ATR Multiplier", defval=3.0)
changeATR= input(title="Change ATR Calculation Method ?", defval=true)
showsignals = input(title="Show Buy/Sell Signals ?", defval=false)
highlighting = input(title="Highlighter On/Off ?", defval=true)
barcoloring = input(title="Bar Coloring On/Off ?", defval=true)

atr2 = ta.sma(ta.atr(14), Periods)
atr= changeATR ? ta.atr(Periods) : atr2

up=src-(Multiplier*atr)
up1 = nz(up[1],up)
up := close[1] > up1 ? math.max(up,up1) : up

dn=src+(Multiplier*atr)
dn1 = nz(dn[1], dn)
dn := close[1] < dn1 ? math.min(dn, dn1) : dn

trend = 1
trend := nz(trend[1], trend)
trend := trend == -1 and close > dn1 ? 1 : trend == 1 and close < up1 ? -1 : trend

buySignal = trend == 1 and trend[1] == -1
sellSignal = trend == -1 and trend[1] == 1

//////////////////////////////////////////
//////////////////////////////////////////

sma1 = ta.sma(close,100)
sma2 = ta.sma(close,200)
smaH = ta.sma(high,200)
smaL = ta.sma(low,200)


checkorder = true

// bearishS = 0.0
// bullishS = 0.0

// bearishM1 = 0.0
// bullishM1 = 0.0

// bearishM2 = 0.0
// bullishM2 = 0.0

// for i=1 to 10
//     if bearishS[i]
//         bullishS

bearishS = ( sellSignal and sma1 < sma2 ) or ( close[2] > sma1[2] and close[1]<sma1[1]  and sma1[1] < sma2[1]  and (sma1[1]-close[1])/(open[1]-close[1]) > 0.5 ) or (close[2] > sma2[2] and close[1]<sma2[1]  and sma1[1] < sma2[1] and (sma2[1]-close[1])/(open[1]-close[1]))    ? true : false
bullishS = ( buySignal and sma1 > sma2 ) or ( close[2] < sma1[2] and close[1]>sma1[1] and sma1[1] > sma2[1]  and (close[1]-sma1[1])/(close[1]-open[1]) > 0.5 ) or ( close[2]< sma2[2] and close[1]>sma2[1] and sma1[1] > sma2[1] and (close[1]-sma2[1])/(close[1]-open[1]) > 0.5 ) ? true : false

// bearishM1 = close[2] > sma1[2] and close[1]<sma1[1]  and sma1[1] < sma2[1]  and (sma1[1]-close[1])/(open[1]-close[1]) > 0.5 ? true : false
// bullishM1 = close[2] < sma1[2] and close[1]>sma1[1] and sma1[1] > sma2[1]  and (close[1]-sma1[1])/(close[1]-open[1]) > 0.5 ? true : false

// bearishM2 = close[2] > sma2[2] and close[1]<sma2[1]  and sma1[1] < sma2[1] and (sma2[1]-close[1])/(open[1]-close[1]) > 0.5? true : false
// bullishM2 = close[2]< sma2[2] and close[1]>sma2[1] and sma1[1] > sma2[1] and (close[1]-sma2[1])/(close[1]-open[1]) > 0.5 ? true : false



for i=1 to 10
    if (bearishS[i] or bullishS[i])

        checkorder :=false




// plot(sma1,color= color.rgb(255,235,62))

envC = plot(sma2,color= color.rgb(0, 188, 212))
envh = plot(smaH,color= color.rgb(0, 188, 212))
envl = plot(smaL,color= color.rgb(0, 188, 212))

fill(envh,envl,color =  color.rgb(0, 188, 212, 60))


plotshape(bearishS and checkorder?open:na ,title = "Sell signal",style=shape.triangledown,size=size.small,location=location.abovebar,color=color.red,text="Short",textcolor = color.red)
plotshape(bullishS and checkorder?open:na ,title = "Buy signal",style=shape.triangleup,size=size.small,location=location.belowbar,color=color.green,text="Long",textcolor = color.green)

